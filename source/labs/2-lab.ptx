                <md alignment="align">
                    <mrow>\frac{dx_1}{dt} \amp = -k_0 x_1,</mrow>
                    <mrow>\frac{dx_2}{dt} \amp = k_0 x_1 - k_1x_2,</mrow>
                    <mrow>\frac{dx_3}{dt} \amp = k_1 x_2.</mrow>
