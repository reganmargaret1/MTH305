  dQdt = ##### FILL IN HERE (the differential equation, not the analytical solution you found)
  return dQdt

t = np.linspace(0,.01)  # Capacitors charge very quickly, so we can look at small time intervals

Q0 = 0     # Initial Condition

y_numerical=odeint(NumericalModel,Q0,t,args=(V0,R,C))  # This will be your numerical solution,
